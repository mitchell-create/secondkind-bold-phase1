# ─── Required ────────────────────────────────────────────────────────────────
# Anthropic — Claude powers all strategy, voice, and brief generation, and the
# dashboard. This is the ONLY key you need to run the voice/brief/strategy steps
# on the SecondKind Bold data that's already in this repo.
ANTHROPIC_API_KEY=your_anthropic_key_here

# ─── Optional — only needed to RE-RUN web research from scratch ───────────────
# The SecondKind Bold research is already generated and committed, so these keys
# are only required if you want to re-run the research / competitor / social
# commands yourself.

# OpenAI — GPT-4o vision (reference + visual-identity analysis during research)
OPENAI_API_KEY=your_openai_key_here

# Firecrawl — website crawling for `adc research` and `adc offers`
FIRECRAWL_API_KEY=your_firecrawl_key_here

# Exa — neural web search for competitor reviews and unfiltered VoC
EXA_API_KEY=your_exa_key_here

# Apify — Amazon + TikTok/Instagram review & comment scraping
APIFY_API_TOKEN=your_apify_token_here

# YouTube Data API v3 — the YouTube path of `adc research-social`
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# OpenRouter — multi-image vision via Gemini (falls back to Claude if unset)
OPENROUTER_API_KEY=your_openrouter_key_here

# Google Drive service account JSON — only for `adc enrich-brand` /
# `adc analyze-references` (pulls brand assets from a Drive folder). Store the
# JSON file OUTSIDE this repo so it is never committed.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
